@page
@model LoginModel
@using HouseRentingSystem.Areas.Identity.Pages.Account

@{
    ViewData["Title"] = "Log in";
}
<div class="logInContainer">
    <h1 class="text-center">@ViewData["Title"]</h1>
    <div class="row">
        <div class="col-md-4 offset-md-4">
            <section class="text-center">
                <form id="account" method="post" class="logInFormContainer">
                    <h2>Use a local account to log in.</h2>
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="form-floating">
                        <input asp-for="Input.Email" class="form-control" aria-required="true"
                               autocomplete="username" />
                        <label asp-for="Input.Email">Email</label>
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>
                    <div class="form-floating">
                        <input asp-for="Input.Password" class="form-control" aria-required="true"
                               autocomplete="password" />
                        <label asp-for="Input.Password">Password</label>
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <button id="login-submit" type="submit" class="btn btn-primary">Log in</button>
                    </div>
                </form>
            </section>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
